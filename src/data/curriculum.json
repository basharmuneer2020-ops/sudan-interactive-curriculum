        },
        "math": {
          "kg1": ["يعد من 1 إلى 10", "يتعرف على 4 أشكال هندسية", "يفرز حسب خاصية واحدة", "يفهم المفاهيم المكانية", "يميز أيام الأسبوع"],
          "kg2": ["يعد من 1 إلى 20", "يجمع ويطرح حسيًا حتى 10", "يتعرف على 5 أشكال", "يقيس أطوال بوحدات غير قياسية", "يقرأ الساعات الكاملة"]
        },
        "islamic": {
          "kg1": ["يحفظ 6 سور (الفاتحة-النصر)", "يحفظ 5 أدعية", "يعرف أركان الإسلام قصصيًا", "يعرف النبي ﷺ وأبويه", "يتصرف بآداب السلام والطعام"],
          "kg2": ["يحفظ 12 سورة", "يعرف قصص 6 أنبياء", "يحفظ 10 أدعية", "يتخلق بـ8 قيم", "يؤدي حركات الصلاة صحيحًا"]
        },
        "science": {
          "kg1": ["يسمي أجزاء جسمه", "يميز 10 حيوانات سودانية", "يتتبع نمو بذرة", "يميز 5 أشجار سودانية", "يفهم الفرق بين الشمس والقمر"],
          "kg2": ["يسمي 3 أعضاء داخلية", "يربط الفصول بالنشاط", "يفهم دورة الماء", "يجري 5 تجارب", "يتبنى عادات صحية وبيئية"]
        },
        "social": {
          "kg1": ["يعرف أسرته الممتدة", "يميز 5 مهن", "يتعرف على علم السودان", "يعرف مدينتين رئيسيتين", "يشارك في نشاط تراثي"],
          "kg2": ["يسمي أقاليم السودان الستة", "يعرف 5 مدن رئيسية", "يحفظ النشيد الوطني كاملًا", "يعرف 3 محطات تاريخية", "يتحلى بسلوك المواطنة"]
        },
        "art": {
          "kg1": ["يميز 6 ألوان", "يستخدم المقص والصلصال", "ينتج 20 عملًا فنيًا", "يعبر بالرسم عن قصة"],
